{
  "name": "@williamthorsen/telefactor-playground",
  "version": "0.1.1",
  "private": true,
  "description": "Playground app that exercises @williamthorsen/telefactor",
  "keywords": [
    "playground",
    "react",
    "telefactor",
    "vite"
  ],
  "license": "UNLICENSED",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "pnpm vite build",
    "dev": "pnpm --filter @williamthorsen/telefactor exec nmr-compile && pnpm vite",
    "preview": "pnpm vite preview",
    "test:pre": "pnpm --filter @williamthorsen/telefactor exec nmr-compile",
    "typecheck:pre": "pnpm --filter @williamthorsen/telefactor exec nmr-compile"
  },
  "dependencies": {
    "@williamthorsen/telefactor": "workspace:*",
    "@williamthorsen/terminal-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@williamthorsen/nmr": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
